# ---------------------------------------------------------------------------
# WorkEasy360 HRMS — PRODUCTION environment for deploy/docker-compose.prod.yml
#
#   cp .env.example .env && chmod 600 .env
#
# Compose uses this file twice: for ${...} substitution in docker-compose.prod.yml,
# and as the environment of the api and migrate containers. Never commit .env.
# Lines marked [generate] need a fresh random value, generated ON the server.
# ---------------------------------------------------------------------------

# --- Host / compose ----------------------------------------------------------------
# The single public hostname. nginx serves the web app and /api/ on it. CORS_ORIGIN,
# APP_URL and the web build's NEXT_PUBLIC_API_URL are derived from it — don't set them.
# No DNS yet? Use <ip-with-dashes>.sslip.io, e.g. 52-66-103-213.sslip.io
DOMAIN=hrms.example.com
# Where Let's Encrypt sends expiry warnings.
LETSENCRYPT_EMAIL=ops@example.com
# Set by deploy.sh to the running release (ghcr.io/<owner>/hrms + commit sha).
IMAGE_PREFIX=hrms
IMAGE_TAG=latest

# --- Database: shared Aurora PostgreSQL, own schema + least-privilege role --------
# Created by deploy/sql/01-create-role-and-schema.sql.
#  - ?schema=hrms puts every table, enum and _prisma_migrations in that schema only.
#  - URL-encode special characters in the password, or use `openssl rand -hex 24`.
#  - sslmode=require encrypts the connection (the cluster is in another region).
#  - Always the WRITER (cluster) endpoint.
DATABASE_URL=postgresql://hrms_app:REPLACE_PASSWORD@my-cluster.xxxxxxxx.eu-north-1.rds.amazonaws.com:5432/postgres?schema=hrms&sslmode=require&connection_limit=10
# The database is ~150 ms away: allow long multi-statement transactions.
DB_TRANSACTION_TIMEOUT_MS=30000
DB_TRANSACTION_MAX_WAIT_MS=10000

# --- Authentication ---------------------------------------------------------------
# [generate] openssl rand -base64 48      (the two must differ; 32+ characters)
JWT_ACCESS_SECRET=replace-me-openssl-rand-base64-48
JWT_REFRESH_SECRET=replace-me-another-openssl-rand-base64-48
# true only until your organization is registered through the UI; then set false and
# `docker compose -f docker-compose.prod.yml up -d api` so nobody else can create one.
ALLOW_PUBLIC_REGISTRATION=true

# --- Time -------------------------------------------------------------------------
# Timezone for "today" (attendance) and times in emails.
APP_TIMEZONE=Asia/Kolkata

# --- Email: Amazon SES, credentials from the EC2 instance role --------------------
# Leave SES_REGION commented out until the sender domain is verified in SES and the
# account is out of the sandbox. Without it the app shows HR temporary passwords
# instead of emailing invites, which is the safe fallback. Once SES works:
# SES_REGION=ap-south-1
# MAIL_FROM="WorkEasy360 HRMS <no-reply@workeasy360.com>"
