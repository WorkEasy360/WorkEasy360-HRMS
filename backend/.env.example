# ── Database ─────────────────────────────────────────────────────────────
# Aurora PostgreSQL / RDS PostgreSQL. Use the cluster *writer* endpoint.
# sslmode=require is needed on RDS (rds.force_ssl is on by default for PostgreSQL 15+).
# connection_limit = DB connections per running API container; keep (containers × limit) well under the DB's max.
# URL-encode special characters in the password (e.g. @ → %40, # → %23, / → %2F).
DATABASE_URL="postgresql://USER:PASSWORD@your-cluster.cluster-xxxx.ap-south-1.rds.amazonaws.com:5432/workeasy360?schema=public&sslmode=require&connection_limit=5"

# ── Auth secrets ─────────────────────────────────────────────────────────
# Required, at least 32 random characters each, and different from each other. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing them signs everyone out.
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

# ── Server ───────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
# Exact origin(s) of the web app, comma-separated, no trailing slash.
CORS_ORIGIN="https://app.example.com"
# Number of proxies in front of the API (1 behind an ALB / App Runner) so rate limits see real client IPs.
TRUST_PROXY=1
# Docker image only: apply pending migrations on start ("true"), or run `npm run migrate:deploy` yourself.
RUN_MIGRATIONS=true

# ── Email (Amazon SES) ───────────────────────────────────────────────────
# Leave SES_REGION empty to disable email: HR then sees temporary passwords on screen instead of sending invites.
SES_REGION=ap-south-1
MAIL_FROM="WorkEasy360 <no-reply@example.com>"
# Public web app URL for links in emails (defaults to the first CORS_ORIGIN).
APP_URL="https://app.example.com"
APP_TIMEZONE=Asia/Kolkata
# Local development: "log" turns on invites/reset links/notifications but prints emails to the console.
# MAIL_TRANSPORT=log
