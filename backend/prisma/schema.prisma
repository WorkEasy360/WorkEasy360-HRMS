generator client {
  provider      = "prisma-client-js"
  // native = the machine running `prisma generate`; the others cover Amazon Linux 2023 (EC2/Beanstalk)
  // and Debian-based Node images (ECS/App Runner), so a build made elsewhere still runs on AWS.
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmployeeStatus {
  ACTIVE
  ONBOARDING
  ON_LEAVE
  EXITED
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum TimesheetStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PayrollRunStatus {
  DRAFT
  PROCESSED
}

enum ReviewCycleStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum ReviewStatus {
  PENDING
  SELF_SUBMITTED
  MANAGER_SUBMITTED
  COMPLETED
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum AutomationTrigger {
  LEAVE_APPROVED
  EMPLOYEE_ONBOARDED
  TIMESHEET_APPROVED
}

enum AutomationActionType {
  CREATE_ANNOUNCEMENT
  ASSIGN_ONBOARDING_TASK
}

enum JobPostingStatus {
  OPEN
  CLOSED
}

enum CandidateStage {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  REIMBURSED
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  RETIRED
}

enum LoanStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  CLOSED
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  departments         Department[]
  employees           Employee[]
  roles               Role[]
  attendanceRecords   AttendanceRecord[]
  leaveTypes          LeaveType[]
  leaveBalances       LeaveBalance[]
  leaveRequests       LeaveRequest[]
  announcements       Announcement[]
  onboardingTasks     OnboardingTask[]
  shiftTemplates      ShiftTemplate[]
  shiftAssignments    ShiftAssignment[]
  timesheetEntries    TimesheetEntry[]
  compensationRecords CompensationRecord[]
  payrollRuns         PayrollRun[]
  payslips            Payslip[]
  reviewCycles        ReviewCycle[]
  performanceReviews  PerformanceReview[]
  goals               Goal[]
  helpDeskTickets     HelpDeskTicket[]
  automationRules     AutomationRule[]
  auditLogs           AuditLog[]
  hrGuideArticles     HrGuideArticle[]
  jobPostings         JobPosting[]
  candidates          Candidate[]
  interviews          Interview[]
  expenseClaims       ExpenseClaim[]
  assets              Asset[]
  loanRequests        LoanRequest[]

  @@map("organizations")
}

model User {
  id                 String    @id @default(uuid())
  organizationId     String
  email              String
  passwordHash       String
  totpSecret         String?
  totpEnabled        Boolean   @default(false)
  // Last TOTP time step accepted, so a code can't be replayed within its window.
  lastTotpStep       Int?
  // Consecutive failed password/TOTP attempts; the account locks briefly after too many.
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  // Set for accounts created with a temporary password.
  mustChangePassword Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee       Employee?
  userRoles      UserRole[]
  auditLogs      AuditLog[]
  refreshTokens  RefreshToken[]
  passwordTokens PasswordToken[]

  @@unique([organizationId, email])
  @@map("users")
}

enum PasswordTokenPurpose {
  INVITE // "set your password" link in the welcome email
  RESET // "forgot password" / HR-initiated reset link
}

// Single-use links for setting a password. Only a SHA-256 hash of the token is stored.
model PasswordToken {
  id        String               @id @default(uuid())
  userId    String
  tokenHash String               @unique
  purpose   PasswordTokenPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime             @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_tokens")
}

// One row per issued refresh token. Tokens rotate on every refresh; presenting a
// revoked token revokes the whole family (likely theft).
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Department {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  parentId       String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children     Department[] @relation("DepartmentHierarchy")
  employees    Employee[]
  jobPostings  JobPosting[]

  @@unique([organizationId, name])
  @@map("departments")
}

model Employee {
  id             String         @id @default(uuid())
  organizationId String
  userId         String         @unique
  employeeCode   String
  firstName      String
  lastName       String
  designation    String?
  phone          String?
  departmentId   String?
  managerId      String?
  dateOfJoining  DateTime?
  // Personal details, filled in by the employee (My Profile); visible only to them and HR.
  dateOfBirth           DateTime? @db.Date
  personalEmail         String?
  address               String?
  emergencyContactName  String?
  emergencyContactPhone String?
  exitDate       DateTime?      @db.Date
  status         EmployeeStatus @default(ONBOARDING)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  department    Department?  @relation(fields: [departmentId], references: [id])
  manager       Employee?    @relation("ManagerHierarchy", fields: [managerId], references: [id])
  directReports Employee[]   @relation("ManagerHierarchy")

  attendanceRecords AttendanceRecord[]
  leaveRequests     LeaveRequest[]     @relation("LeaveRequester")
  approvedRequests  LeaveRequest[]     @relation("LeaveApprover")
  leaveBalances     LeaveBalance[]
  announcements     Announcement[]

  onboardingTasks     OnboardingTask[]
  shiftAssignment     ShiftAssignment?
  timesheetEntries    TimesheetEntry[]     @relation("TimesheetOwner")
  approvedTimesheets  TimesheetEntry[]     @relation("TimesheetApprover")
  compensationRecords CompensationRecord[]
  payslips            Payslip[]

  performanceReviews     PerformanceReview[] @relation("ReviewSubject")
  reviewsAsReviewer      PerformanceReview[] @relation("ReviewReviewer")
  goals                  Goal[]
  helpDeskTickets        HelpDeskTicket[]    @relation("TicketRequester")
  assignedTickets        HelpDeskTicket[]    @relation("TicketAssignee")
  hrGuideArticles        HrGuideArticle[]
  createdAutomationRules AutomationRule[]

  postedJobPostings  JobPosting[]   @relation("JobPostingPoster")
  interviewsAsPanel  Interview[]    @relation("InterviewInterviewer")
  expenseClaims      ExpenseClaim[] @relation("ExpenseOwner")
  approvedExpenses   ExpenseClaim[] @relation("ExpenseApprover")
  assignedAssets     Asset[]
  loanRequests       LoanRequest[]  @relation("LoanOwner")
  approvedLoans      LoanRequest[]  @relation("LoanApprover")
  hiredFromCandidate Candidate?     @relation("CandidateHired")

  @@unique([organizationId, employeeCode])
  @@map("employees")
}

model AttendanceRecord {
  id             String    @id @default(uuid())
  organizationId String
  employeeId     String
  date           DateTime  @db.Date
  checkInAt      DateTime?
  checkOutAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@map("attendance_records")
}

model LeaveType {
  id                 String   @id @default(uuid())
  organizationId     String
  name               String
  defaultDaysPerYear Int      @default(0)
  createdAt          DateTime @default(now())

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leaveRequests LeaveRequest[]
  leaveBalances LeaveBalance[]

  @@unique([organizationId, name])
  @@map("leave_types")
}

model LeaveBalance {
  id             String @id @default(uuid())
  organizationId String
  employeeId     String
  leaveTypeId    String
  year           Int
  allocatedDays  Float  @default(0)
  usedDays       Float  @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType    LeaveType    @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leaveTypeId, year])
  @@map("leave_balances")
}

model LeaveRequest {
  id             String             @id @default(uuid())
  organizationId String
  employeeId     String
  leaveTypeId    String
  startDate      DateTime           @db.Date
  endDate        DateTime           @db.Date
  days           Float
  reason         String?
  status         LeaveRequestStatus @default(PENDING)
  approverId     String?
  decisionNote   String?
  decidedAt      DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation("LeaveRequester", fields: [employeeId], references: [id], onDelete: Cascade)
  approver     Employee?    @relation("LeaveApprover", fields: [approverId], references: [id])
  leaveType    LeaveType    @relation(fields: [leaveTypeId], references: [id])

  @@map("leave_requests")
}

model Announcement {
  id             String   @id @default(uuid())
  organizationId String
  authorId       String
  title          String
  body           String
  publishedAt    DateTime @default(now())
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       Employee     @relation(fields: [authorId], references: [id])

  @@map("announcements")
}

model OnboardingTask {
  id             String    @id @default(uuid())
  organizationId String
  employeeId     String
  title          String
  done           Boolean   @default(false)
  dueDate        DateTime? @db.Date
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("onboarding_tasks")
}

model ShiftTemplate {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  startTime      String
  endTime        String
  createdAt      DateTime @default(now())

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shiftAssignments ShiftAssignment[]

  @@unique([organizationId, name])
  @@map("shift_templates")
}

model ShiftAssignment {
  id              String   @id @default(uuid())
  organizationId  String
  employeeId      String   @unique
  shiftTemplateId String
  effectiveFrom   DateTime @db.Date
  updatedAt       DateTime @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftTemplate ShiftTemplate @relation(fields: [shiftTemplateId], references: [id])

  @@map("shift_assignments")
}

model TimesheetEntry {
  id             String          @id @default(uuid())
  organizationId String
  employeeId     String
  date           DateTime        @db.Date
  hours          Float
  task           String?
  status         TimesheetStatus @default(PENDING)
  approverId     String?
  decidedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation("TimesheetOwner", fields: [employeeId], references: [id], onDelete: Cascade)
  approver     Employee?    @relation("TimesheetApprover", fields: [approverId], references: [id])

  @@unique([employeeId, date])
  @@map("timesheet_entries")
}

model CompensationRecord {
  id             String   @id @default(uuid())
  organizationId String
  employeeId     String
  effectiveFrom  DateTime @db.Date
  annualCTC      Float
  monthlyGross   Float
  currency       String   @default("INR")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("compensation_records")
}

model PayrollRun {
  id             String           @id @default(uuid())
  organizationId String
  month          Int
  year           Int
  status         PayrollRunStatus @default(DRAFT)
  processedAt    DateTime?
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payslips     Payslip[]

  @@unique([organizationId, month, year])
  @@map("payroll_runs")
}

model Payslip {
  id             String   @id @default(uuid())
  organizationId String
  payrollRunId   String
  employeeId     String
  grossPay       Float
  deductions     Float
  netPay         Float
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payrollRun   PayrollRun   @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([payrollRunId, employeeId])
  @@map("payslips")
}

model ReviewCycle {
  id             String            @id @default(uuid())
  organizationId String
  name           String
  startDate      DateTime          @db.Date
  endDate        DateTime          @db.Date
  status         ReviewCycleStatus @default(DRAFT)
  createdAt      DateTime          @default(now())

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reviews      PerformanceReview[]
  goals        Goal[]

  @@map("review_cycles")
}

model PerformanceReview {
  id                String       @id @default(uuid())
  organizationId    String
  cycleId           String
  employeeId        String
  reviewerId        String?
  selfAssessment    String?
  managerAssessment String?
  rating            Int?
  status            ReviewStatus @default(PENDING)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cycle        ReviewCycle  @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employee     Employee     @relation("ReviewSubject", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewer     Employee?    @relation("ReviewReviewer", fields: [reviewerId], references: [id])

  @@unique([cycleId, employeeId])
  @@map("performance_reviews")
}

model Goal {
  id             String     @id @default(uuid())
  organizationId String
  employeeId     String
  cycleId        String?
  title          String
  description    String?
  status         GoalStatus @default(NOT_STARTED)
  progress       Int        @default(0)
  dueDate        DateTime?  @db.Date
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  cycle        ReviewCycle? @relation(fields: [cycleId], references: [id])

  @@map("goals")
}

model HelpDeskTicket {
  id             String       @id @default(uuid())
  organizationId String
  employeeId     String
  category       String
  subject        String
  description    String
  status         TicketStatus @default(OPEN)
  assignedToId   String?
  createdAt      DateTime     @default(now())
  resolvedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation("TicketRequester", fields: [employeeId], references: [id], onDelete: Cascade)
  assignedTo   Employee?    @relation("TicketAssignee", fields: [assignedToId], references: [id])

  @@map("helpdesk_tickets")
}

model AutomationRule {
  id             String               @id @default(uuid())
  organizationId String
  createdById    String
  name           String
  trigger        AutomationTrigger
  actionType     AutomationActionType
  actionConfig   Json
  enabled        Boolean              @default(true)
  createdAt      DateTime             @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    Employee     @relation(fields: [createdById], references: [id])

  @@map("automation_rules")
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String
  actorUserId    String?
  action         String
  entityType     String
  entityId       String?
  before         Json?
  after          Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorUserId], references: [id])

  @@map("audit_logs")
}

model HrGuideArticle {
  id             String   @id @default(uuid())
  organizationId String
  authorId       String
  title          String
  body           String
  category       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       Employee     @relation(fields: [authorId], references: [id])

  @@map("hr_guide_articles")
}

model JobPosting {
  id             String           @id @default(uuid())
  organizationId String
  postedById     String
  title          String
  departmentId   String?
  description    String
  status         JobPostingStatus @default(OPEN)
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  postedBy     Employee     @relation("JobPostingPoster", fields: [postedById], references: [id])
  department   Department?  @relation(fields: [departmentId], references: [id])
  candidates   Candidate[]

  @@map("job_postings")
}

model Candidate {
  id              String         @id @default(uuid())
  organizationId  String
  jobPostingId    String
  firstName       String
  lastName        String
  email           String
  phone           String?
  source          String?
  stage           CandidateStage @default(APPLIED)
  notes           String?
  hiredEmployeeId String?        @unique
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobPosting    JobPosting   @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  interviews    Interview[]
  hiredEmployee Employee?    @relation("CandidateHired", fields: [hiredEmployeeId], references: [id])

  @@map("candidates")
}

model Interview {
  id             String   @id @default(uuid())
  organizationId String
  candidateId    String
  interviewerId  String
  scheduledAt    DateTime
  feedback       String?
  rating         Int?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidate    Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  interviewer  Employee     @relation("InterviewInterviewer", fields: [interviewerId], references: [id])

  @@map("interviews")
}

model ExpenseClaim {
  id             String        @id @default(uuid())
  organizationId String
  employeeId     String
  category       String
  amount         Float
  currency       String        @default("INR")
  expenseDate    DateTime      @db.Date
  description    String?
  status         ExpenseStatus @default(PENDING)
  approverId     String?
  decisionNote   String?
  decidedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation("ExpenseOwner", fields: [employeeId], references: [id], onDelete: Cascade)
  approver     Employee?    @relation("ExpenseApprover", fields: [approverId], references: [id])

  @@map("expense_claims")
}

model Asset {
  id             String      @id @default(uuid())
  organizationId String
  name           String
  category       String
  serialNumber   String?
  status         AssetStatus @default(AVAILABLE)
  assignedToId   String?
  assignedAt     DateTime?
  createdAt      DateTime    @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTo   Employee?    @relation(fields: [assignedToId], references: [id])

  @@map("assets")
}

model LoanRequest {
  id               String     @id @default(uuid())
  organizationId   String
  employeeId       String
  amount           Float
  reason           String?
  emiMonths        Int
  monthlyDeduction Float?
  remainingAmount  Float?
  status           LoanStatus @default(PENDING)
  approverId       String?
  decisionNote     String?
  decidedAt        DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation("LoanOwner", fields: [employeeId], references: [id], onDelete: Cascade)
  approver     Employee?    @relation("LoanApprover", fields: [approverId], references: [id])

  @@map("loan_requests")
}

model Role {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([organizationId, name])
  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  key         String  @unique
  description String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}
