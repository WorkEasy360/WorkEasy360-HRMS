# Copy to .env on the server and fill in. Never commit the real .env.

# Domain pointing (DNS A record) at the EC2 Elastic IP, without https://
DOMAIN=hr.example.com
# Email for Let's Encrypt certificate notices
ACME_EMAIL=you@example.com

# Aurora/RDS writer endpoint. URL-encode special characters in the password (@ → %40, # → %23, / → %2F).
DATABASE_URL=postgresql://USER:PASSWORD@your-cluster.cluster-xxxx.ap-south-1.rds.amazonaws.com:5432/workeasy360?schema=public&sslmode=require&connection_limit=10

# 32+ random characters each, different from each other. Generate with:
#   openssl rand -base64 48 | tr -d '/+=' | cut -c1-48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ── Email (Amazon SES) ─────────────────────────────────────────────────────
# Region where your SES identity (domain) is verified, e.g. ap-south-1.
SES_REGION=ap-south-1
# Sender. The domain must be verified in SES.
MAIL_FROM="WorkEasy360 <no-reply@example.com>"
# Timezone used for dates/times in emails (interview slots).
APP_TIMEZONE=Asia/Kolkata
# AWS credentials: preferred is an IAM role on the EC2 instance with ses:SendEmail (leave these unset).
# Only if you can't use a role, uncomment and fill an IAM user's keys limited to ses:SendEmail:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
